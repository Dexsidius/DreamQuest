small_02.png","title":"sapling","type":"tree","x":3600,"y":2992,"yield":"logs","yield_xp":25},{"gather_time":2.200000047683716,"id":"tree_253","skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/treesmall_00.png","title":"sapling","type":"tree","x":3632,"y":2992,"yield":"logs","yield_xp":25},{"gather_time":2.200000047683716,"id":"tree_254","skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/treesmall_08.png","title":"sapling","type":"tree","x":3952,"y":2992,"yield":"logs","yield_xp":25},{"id":"sign_gate","sprite":"assets/props/signpost.png","text":"HAVENBROOK, south.\nEMBERFELL MINE, north along the Sunken Road.\n\nBelow, scratched later and deeper:\nthe road is not safe after the second milestone.","title":"Waymarker","type":"sign","x":2088,"y":2808},{"id":"note_mire","sprite":"assets/objects/rocksmall_00.png","starts_quest":"q_barrow_seal","text":"If you are reading this I did not come back out, and you should not go in.\n\nI am going anyway. There is a seal down there with my grandmother's name pressed into it, and the guild has known about it for forty years.\n\nIf you find the seal, do not give it to Orlend. Ask him why he never told anyone first.","title":"A water-stained note","type":"note","x":472,"y":1504},{"id":"note_surveyor","loot":"page_surveyor","sprite":"assets/objects/rocksmall_02.png","text":"Third day on the road. Counted twelve of them at the second milestone. Counted thirty at the third.\n\nThey are not raiding. They are walking north, in order, and they are all walking to the same place.\n\nI have drawn it below as best I can from the ridge. It is a mine adit. It is the Emberfell adit.","title":"Torn survey page","type":"note","x":1932,"y":1552},{"id":"chest_meadow_01","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":3072,"y":2496},{"id":"chest_wood_01","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":3648,"y":1664},{"id":"chest_mire_01","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":320,"y":1920}],"portals":[{"interact":false,"label":"Enter Havenbrook","rect":[1984,2816,96,48],"spawn":"from_field","target":"town_havenbrook"},{"interact":true,"label":"Enter the Emberfell mine","rect":[2100,272,56,40],"spawn":"entrance","target":"dungeon_emberfell_1"},{"interact":true,"label":"Enter the barrow","rect":[372,1392,56,40],"spawn":"entrance","target":"dungeon_barrow"}],"solid":[],"spawns":{"from_barrow":[400,1464],"from_mine":[2128,344],"from_town":[2032,2776],"start":[2032,2776]},"tile_size":16,"version":1},"name":"The Hollowmarch","tiles":{"bush_00":{"filepath":"assets/objects/bush_00.png","locations":[[2640,880,64,64],[3024,944,64,64],[2640,976,64,64],[3376,1072,64,64],[3248,1296,64,64],[3504,1296,64,64],[3536,1360,64,64],[3408,1424,64,64],[3216,2064,64,64],[3536,2320,64,64],[2928,2768,64,64]]},"bush_01":{"filepath":"assets/objects/bush_01.png","locations":[[3728,1616,64,64],[2640,1712,64,64],[2800,1712,64,64],[2704,2128,64,64],[2768,2448,64,64],[3056,2448,64,64],[3056,2480,64,64],[2768,2736,64,64],[3152,2928,64,64]]},"bush_02":{"filepath":"assets/objects/bush_02.png","locations":[[3920,1936,64,64],[3344,2032,64,64],[3984,2096,64,64],[3760,2128,64,64],[3280,2480,64,64],[2864,2512,64,64],[3344,2576,64,64]]},"bush_03":{"filepath":"assets/objects/bush_03.png","locations":[[2704,1008,64,64],[2960,1072,64,64],[3376,1584,64,64],[2960,1808,64,64],[2864,1968,64,64],[3472,2448,64,64],[3632,2512,64,64],[3696,2640,64,64],[2736,2928,64,64]]},"bush_04":{"filepath":"assets/objects/bush_04.png","locations":[[2896,880,64,64],[2928,976,64,64],[3760,1840,64,64],[3536,1968,64,64],[3920,2192,64,64],[3248,2384,64,64],[3664,2384,64,64],[3824,2384,64,64],[2896,2480,64,64],[2736,2704,64,64],[3344,2704,64,64],[2672,2768,64,64],[3184,2960,64,64]]},"bush_05":{"filepath":"assets/objects/bush_05.