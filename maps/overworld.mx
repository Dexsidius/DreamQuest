ops/herb_brookmint.png","sprite_open":"assets/props/herb_brookmint_picked.png","title":"brookmint","type":"herb","x":1641,"y":2060,"yield":"brookmint","yield_xp":45},{"gather_time":1.472000002861023,"id":"herb_229","regrow":2.085714340209961,"skill":"Foraging","skill_level":6,"sprite":"assets/props/herb_brookmint.png","sprite_open":"assets/props/herb_brookmint_picked.png","title":"brookmint","type":"herb","x":1713,"y":2068,"yield":"brookmint","yield_xp":45},{"gather_time":1.472000002861023,"id":"herb_230","regrow":2.085714340209961,"skill":"Foraging","skill_level":6,"sprite":"assets/props/herb_brookmint.png","sprite_open":"assets/props/herb_brookmint_picked.png","title":"brookmint","type":"herb","x":1612,"y":2102,"yield":"brookmint","yield_xp":45},{"fish":["raw_minnow","raw_pike","raw_eel"],"gather_time":3.5999999046325684,"id":"fish_lake_0","skill":"Fishing","skill_level":1,"title":"lake","type":"fishing_spot","x":120,"y":1872},{"fish":["raw_minnow","raw_pike","raw_eel"],"gather_time":3.5999999046325684,"id":"fish_lake_1","skill":"Fishing","skill_level":1,"title":"lake","type":"fishing_spot","x":504,"y":1968},{"fish":["raw_minnow","raw_pike","raw_eel"],"gather_time":3.5999999046325684,"id":"fish_lake_2","skill":"Fishing","skill_level":1,"title":"lake","type":"fishing_spot","x":728,"y":2064},{"fish":["raw_minnow","raw_pike","raw_eel"],"gather_time":3.5999999046325684,"id":"fish_lake_3","skill":"Fishing","skill_level":1,"title":"lake","type":"fishing_spot","x":952,"y":2160},{"id":"sign_gate","sprite":"assets/props/signpost.png","text":"HAVENBROOK, south through the gate.\nEMBERFELL MINE, north along the Sunken Road.\n\nBelow, scratched later and deeper:\nthe road is not safe after the second milestone.","title":"Waymarker","type":"sign","x":2750,"y":2742},{"id":"note_mire","sprite":"assets/icons/note_ground.png","starts_quest":"q_barrow_seal","text":"If you are reading this I did not come back out, and you should not go in.\n\nI am going anyway. There is a seal down there with my grandmother's name pressed into it, and the guild has known about it for forty years.\n\nIf you find the seal, do not give it to Orlend. Ask him why he never told anyone first.","title":"A water-stained note","type":"note","x":1112,"y":1504},{"id":"note_surveyor","loot":"page_surveyor","sprite":"assets/icons/note_ground.png","text":"Third day on the road. Counted twelve of them at the second milestone. Counted thirty at the third.\n\nThey are not raiding. They are walking north, in order, and they are all walking to the same place.\n\nI have drawn it below as best I can from the ridge. It is a mine adit. It is the Emberfell adit.","title":"Torn survey page","type":"note","x":2572,"y":1552},{"id":"sign_trailhead","sprite":"assets/props/signpost.png","starts_quest":"q_road_beneath_leaves","text":"WHISPERWOOD TRAIL, east.\nMOSSVALE, a day's walk under the trees.\nFERNHOLLOW, where the trail forks north.\n\nCarved smaller: keep to the path after dark.\n\nFollow the road east to Mossvale, then return to the fork and take the north path to Fernhollow.","title":"Trailhead","type":"sign","x":2576,"y":1808},{"id":"range_lizard_camp","sprite":"assets/props/campfire_ring.png","title":"Camp fire","type":"range","x":1078,"y":2584},{"id":"sign_bayou","sprite":"assets/props/signpost.png","text":"WEST: THE BAYOU\n\nPainted on the post in lizardman red, and scratched under it by somebody who could write: the water there is not empty. Do not walk the edge.","title":"The Bayou","type":"sign","x":220,"y":2514},{"id":"sign_hollowrest","sprite":"assets/props/signpost.png","text":"HOLLOWREST BURYING GROUND\n\nHavenbrook's dead, and Emberfell's, and whoever the road left.\n\nUnder it, cut later and deeper: THEY DO NOT STAY DOWN. SHUT THE GATE.","title":"Hollowrest","type":"sign","x":1956,"y":3152},{"id":"chest_hollowrest","loot":"chest_hollowrest","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":1740,"y":3780},{"id":"sign_ice_spire","sprite":"assets/props/signpost.png","text":"ICE SPIRE PEAK, north, up the goat track.\n\nTrolls on the high slopes. Wyverns nest at the summit.\n\nThe warden's mark is cut under it: no one below Combat 30 is let past this stone.","title":"The climb north","type":"sign","x":1504,"y":96},{"id":"sign_ashen_path","sprite":"assets/props/signpost.png","text":"Somebody has burnt letters into it.\n\nTHE ASHEN PATH. At its end, the pit.\n\nDo not go on unless you have fought for a long time and won: Combat 40.","title":"A burnt stake","type":"sign","x":4586,"y":1546},{"id":"chest_meadow_01","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":3712,"y":2496},{"id":"chest_wood_01","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":4288,"y":1664},{"id":"chest_mire_01","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":960,"y":1920},{"gather_time":1.2540000677108765,"id":"bug_0","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":3882,"y":2964,"yield":"swallowtail","yield_xp":55},{"gather_time":1.2540000677108765,"id":"bug_1","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":4143,"y":3318,"yield":"swallowtail","yield_xp":55},{"gather_time":1.2540000677108765,"id":"bug_2","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":3987,"y":3724,"yield":"swallowtail","yield_xp":55},{"gather_time":1.2540000677108765,"id":"bug_3","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":4520,"y":2448,"yield":"swallowtail","yield_xp":55},{"gather_time":1.2540000677108765,"id":"bug_4","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":4342,"y":3757,"yield":"swallowtail","yield_xp":55},{"gather_time":1.2540000677108765,"id":"bug_5","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":3666,"y":1039,"yield":"swallowtail","yield_xp":55},{"gather_time":1.2540000677108765,"id":"bug_6","regrow":2.2285714149475098,"skill":"Foraging","skill_level":9,"title":"swallowtail butterfly","type":"bug","x":4491,"y":1495,"yield":"swallowtail","yield_xp":55},{"id":"curio_bell_clapper","item":"bell_clapper","item_qty":1,"sprite":"assets/icons/bell_clapper.png","starts_quest":"q_tongueless_bell","title":"the bell clapper","type":"curio","x":1964,"y":3284}],"portals":[{"interact":false,"label":"Enter Havenbrook","rect":[2636,2822,72,44],"spawn":"from_field","target":"town_havenbrook"},{"interact":true,"label":"Enter the Emberfell mine","level":10,"rect":[2750,264,36,30],"spawn":"entrance","target":"dungeon_emberfell_1"},{"interact":true,"label":"Enter the barrow","level":20,"rect":[1022,1408,36,30],"spawn":"entrance","target":"dungeon_barrow"},{"interact":false,"label":"To the Whisperwood","rect":[4712,1925,24,144],"spawn":"from_hollowmarch","target":"whisperwood_trail"},{"interact":false,"label":"To the Bayou","level":30,"rect":[0,2504,24,144],"spawn":"from_hollowmarch","target":"bayou"},{"interact":true,"label":"Go down into the crypt","level":34,"rect":[1852,3782,40,28],"spawn":"entrance","target":"crypt_1"},{"interact":false,"label":"To the Ice Spire","level":34,"min_combat":30,"rect":[1360,0,128,24],"spawn":"from_hollowmarch","target":"ice_spire_peak"},{"interact":false,"label":"To the Ashen Path","level":45,"min_combat":40,"rect":[4712,1544,24,144],"spawn":"from_hollowmarch","target":"ashen_path"}],"solid":[],"sort_lift":{"barrow_mound":76,"crypt_open":74,"lych_gate":60,"mine_adit":103},"spawns":{"default":[2672,2776],"from_ashen":[4640,1616],"from_barrow":[1040,1496],"from_bayou":[88,2576],"from_cryp