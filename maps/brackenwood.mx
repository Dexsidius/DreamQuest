e the size, and the hide turns a spear.\n\nCombat 65, or go home.","title":"A board, split down the middle","type":"sign","x":2144,"y":800},{"id":"chest_brackenwood_west","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":704,"y":1314},{"id":"chest_old_growth","loot":"chest_dungeon","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":3422,"y":288}],"portals":[{"interact":false,"label":"To the Westwold","rect":[1976,3496,144,24],"spawn":"from_brackenwood","target":"westwold"}],"solid":[],"spawns":{"default":[2064,3392],"from_westwold":[2064,3392]},"subtitle":"Old forest north of the Westwold. It has bears in it","tile_size":16,"version":1,"water":[]},"name":"The Brackenwood","tiles":{"bear_den":{"filepath":"assets/props/bear_den.png","locations":[[2064,760,144,144]]},"bush_00":{"filepath":"assets/objects/bush_00.png","locations":[[2896,80,64,64],[3984,80,64,64],[592,144,64,64],[1360,208,64,64],[3920,272,64,64],[272,304,64,64],[1456,336,64,64],[3920,336,64,64],[1392,368,64,64],[2032,400,64,64],[752,464,64,64],[1936,496,64,64],[3760,496,64,64],[464,528,64,64],[3440,528,64,64],[3824,528,64,64],[592,560,64,64],[656,592,64,64],[2672,624,64,64],[3728,624,64,64],[976,656,64,64],[1392,656,64,64],[1904,656,64,64],[400,688,64,64],[1680,688,64,64],[816,720,64,64],[2096,720,64,64],[3568,752,64,64],[560,816,64,64],[1360,816,64,64],[2608,848,64,64],[3440,848,64,64],[144,912,64,64],[1776,912,64,64],[432,944,64,64],[1104,976,64,64],[1136,1008,64,64],[1264,1008,64,64],[144,1040,64,64],[2672,1040,64,64],[1808,1072,64,64],[3568,1072,64,64],[2768,1104,64,64],[3024,1104,64,64],[3088,1104,64,64],[1008,1136,64,64],[368,1168,64,64],[3856,1168,64,64],[912,1232,64,64],[1360,1328,64,64],[3248,1392,64,64],[1456,1424,64,64],[1776,1424,64,64],[272,1456,64,64],[2480,1456,64,64],[3280,1456,64,64],[3856,1456,64,64],[1200,1488,64,64],[3152,1488,64,64],[1424,1520,64,64],[2288,1520,6