,0.0,0],[112,736,9.0,1],[884,736,0.0,0],[884,544,6.0,3],[884,682,0.0,0],[1664,682,9.0,2],[940,682,0.0,0],[940,1280,0.0,0]],"phase":0.0,"ping_pong":false,"speed":34.0,"sprite":"fighter2","tint":[255,255,255],"wanders":false,"x":884,"y":1280},{"dialogue":"tam_root","facing":0,"hours":[7.0,17.0],"id":"npc_tam","name":"Tam","path":[[392,352,9.0,1],[544,352,0.0,0],[544,736,0.0,0],[544,1120,0.0,0],[480,1120,8.0,3]],"phase":25.0,"ping_pong":true,"speed":32.0,"sprite":"citizen2","tint":[255,244,214],"wanders":false,"x":392,"y":352},{"dialogue":"dace_root","facing":0,"hours":[9.0,20.0],"id":"npc_dace","name":"Dace","path":[[1450,614,8.0,0],[1450,740,0.0,0],[1230,740,0.0,0],[1230,1202,0.0,0],[1480,1202,24.0,2]],"phase":90.0,"ping_pong":true,"speed":28.0,"sprite":"citizen1","tint":[220,240,255],"wanders":false,"x":1450,"y":614},{"dialogue":"pip_root","facing":0,"hours":[7.0,19.0],"id":"npc_pip","name":"Pip","path":[[912,480,6.0,0],[912,704,0.0,0],[1024,792,5.0,2],[912,792,0.0,0],[912,1280,5.0,0],[912,704,0.0,0]],"phase":10.0,"ping_pong":false,"speed":50.0,"sprite":"citizen2","tint":[236,255,230],"wanders":false,"x":912,"y":480},{"dialogue":"carter_root","facing":0,"hours":[8.0,17.0],"id":"npc_carter","name":"Hollis the Carter","path":[[912,1344,14.0,3],[912,720,0.0,0],[64,720,14.0,1]],"phase":140.0,"ping_pong":true,"speed":30.0,"sprite":"citizen1","tint":[255,226,200],"wanders":false,"x":912,"y":1344},{"dialogue":"sorrel_root","facing":0,"hours":[10.0,16.0],"id":"npc_ranger","name":"Sorrel","path":[[64,688,10.0,2],[1230,688,0.0,0],[1230,900,0.0,0],[1440,912,16.0,2]],"phase":60.0,"ping_pong":true,"speed":36.0,"sprite":"player_warden","tint":[255,255,255],"wanders":false,"x":64,"y":688}],"objects":[{"id":"sign_west_gate","sprite":"assets/props/signpost.png","text":"THE WESTWOLD ROAD\n\nHidewater steading, half a mile. The river Wend, two. Beyond the fork: the Brackenwood, north; the Howling Fells, west.\n\nNailed under it, in a tanner's hand: WOLVES ON THE DOWNS. Pelts bought at Hidewater.","title":"West Gate","type":"sign","x":104,"y":660},{"id":"sign_guild_hall","sprite":"assets/objects/sign_guild.png","text":"THE ADVENTURERS' GUILD OF HAVENBROOK\n\nContracts posted within. Dues payable within. Complaints, also within, and briefly.","title":"Havenbrook Guild Hall","type":"sign","x":1008,"y":448},{"id":"board_havenbrook","quests":["q_thin_the_herd","q_firewood","q_ore_for_the_forge","q_orc_trouble"],"sprite":"assets/objects/guild_noticeboard.png","title":"Havenbrook Mission Board","type":"board","x":1056,"y":768},{"id":"sign_well","sprite":"assets/props/signpost.png","text":"HAVENBROOK WELL\n\nFour hundred buckets a day, and a queue from dawn.\n\nUnder that, on a board nailed over the winch: DRY SINCE THE BAD YEAR. DO NOT LOWER THE BUCKET. DO NOT GO DOWN.","title":"The town well","type":"sign","x":738,"y":806},{"id":"range_town","sprite":"assets/props/campfire_ring.png","title":"Cooking fire","type":"range","x":1280,"y":960},{"id":"cauldron_town","sprite":"assets/props/cauldron.png","station":"cauldron","title":"Cauldron","type":"workbench","x":1376,"y":960},{"id":"waystone_havenbrook","sprite":"assets/props/waystone.png","sprite_open":"assets/props/waystone_lit.png","title":"Waystone","type":"waystone","x":1010,"y":652},{"id":"sign_farm","sprite":"assets/props/signpost.png","text":"MARROW FARM\n\nEGGS. MILK. FLEECES. MUTTON, PORK AND BEEF IN SEASON.\n\nUnder it: MIND THE GATES. IF YOU LET THE PIGS OUT YOU ARE GETTING THEM BACK IN.","title":"Marrow Farm","type":"sign","x":1824,"y":432},{"id":"rack_tannery_0","sprite":"assets/props/tanning_rack.png","station":"rack","title":"Tanning rack","type":"workbench","x":172,"y":800},{"id":"rack_tannery_1","sprite":"assets/props/tanning_rack.png","station":"rack","title":"Tanning rack","type":"workbench","x":256,"y":800},{"id":"rack_tannery_2","sprite":"assets/props/tanning_rack.png","station":"rack","title":"Tanning rack","type":"workbench","x":340,"y":800},{"id":"sign_tannery","sprite":"assets/props/signpost.png","text":"NESSA'S TANNERY\n\nHIDES CURED. THREAD WAXED. LEATHER CUT TO ORDER.\n\nUnder it, in a newer hand: WORK WANTED. I PAY FOR WHAT YOU MAKE, NOT FOR WHAT YOU FIND. ASK ME FOR THE BOOK.","title":"The Tannery","type":"sign","x":138,"y":884},{"id":"bench_town","sprite":"assets/props/workbench.png","station":"workbench","title":"Workbench","type":"workbench","x":640,"y":1088},{"id":"sign_sawpit","sprite":"assets/props/signpost.png","text":"THE SAWPIT\n\nTimber cut and sawn. Firewood by the cord.\n\nUnder it, in newer paint: apprentices wanted. Axe provided.","title":"Havenbrook Sawpit","type":"sign","x":410,"y":294},{"deplete":0.25,"gather_time":2.200000047683716,"id":"tree_900","regrow":1.0,"skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/treesmall_02.png","sprite_open":"assets/objects/stumpsmall.png","title":"sapling","type":"tree","x":112,"y":144,"yield":"logs","yield_xp":25},{"deplete":0.25,"gather_time":2.200000047683716,"id":"tree_901","regrow":1.0,"skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/treesmall_00.png","sprite_open":"assets/objects/stumpsmall.png","title":"sapling","type":"tree","x":176,"y":112,"yield":"logs","yield_xp":25},{"deplete":0.25,"gather_time":2.200000047683716,"id":"tree_902","regrow":1.0,"skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/treesmall_08.png","sprite_open":"assets/objects/stumpsmall.png","title":"sapling","type":"tree","x":240,"y":144,"yield":"logs","yield_xp":25},{"deplete":0.125,"gather_time":3.0269999504089355,"id":"tree_903","regrow":1.5,"skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/tree_07.png","sprite_open":"assets/objects/stump.png","title":"oak","type":"tree","x":144,"y":240,"yield":"logs","yield_xp":70},{"deplete":0.125,"gather_time":3.0269999504089355,"id":"tree_904","regrow":1.5,"skill":"Woodcutting","skill_level":1,"sprite":"assets/objects/tree_00.png","sprite_open":"assets/objects/stump.png","title":"oak","type":"tree","x":208,"y":208,"yie