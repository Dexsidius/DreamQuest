","regrow":1.0199999809265137,"skill":"Mining","skill_level":1,"sprite":"assets/objects/ore_copper_1.png","title":"copper seam","type":"rock","x":1456,"y":112,"yield":"copper_ore","yield_xp":65},{"deplete":0.16699999570846558,"gather_time":3.2200000286102295,"id":"rock_902","regrow":1.0199999809265137,"skill":"Mining","skill_level":1,"sprite":"assets/objects/ore_copper_1.png","title":"copper seam","type":"rock","x":1584,"y":144,"yield":"copper_ore","yield_xp":65},{"deplete":0.3330000042915344,"gather_time":2.4200000762939453,"id":"rock_903","regrow":0.7699999809265137,"skill":"Mining","skill_level":1,"sprite":"assets/objects/oresmall_copper_1.png","title":"copper outcrop","type":"rock","x":1648,"y":208,"yield":"copper_ore","yield_xp":26},{"deplete":0.3330000042915344,"gather_time":2.4200000762939453,"id":"rock_904","regrow":0.7699999809265137,"skill":"Mining","skill_level":1,"sprite":"assets/objects/oresmall_copper_0.png","title":"copper outcrop","type":"rock","x":1424,"y":304,"yield":"copper_ore","yield_xp":26},{"deplete":0.16699999570846558,"gather_time":3.2200000286102295,"id":"rock_905","regrow":1.0199999809265137,"skill":"Mining","skill_level":1,"sprite":"assets/objects/ore_copper_1.png","title":"copper seam","type":"rock","x":1616,"y":304,"yield":"copper_ore","yield_xp":65},{"id":"sign_pond","sprite":"assets/props/signpost.png","text":"THE MILL POND\n\nMinnow and pike. Keep the jetty clear.\n\nA smaller hand has added: rods lent, fish shared.","title":"The Mill Pond","type":"sign","x":1312,"y":1088},{"fish":["raw_minnow","raw_pike"],"gather_time":3.5999999046325684,"id":"fish_pond_1","skill":"Fishing","skill_level":1,"title":"pond","type":"fishing_spot","x":1520,"y":1200},{"fish":["raw_minnow"],"gather_time":3.5999999046325684,"id":"fish_pond_2","skill":"Fishing","skill_level":1,"title":"pond","type":"fishing_spot","x":1424,"y":1296}],"portals":[{"interact":false,"label":"To the Westwold","level":5,"rect":[0,664,24,112],"spawn":"from_havenbrook","target":"westwold"},{"interact":false,"label":"Leave Havenbrook","rect":[832,1368,160,40],"spawn":"from_town","target":"overworld"},{"interact":true,"label":"Enter the guild hall","rect":[897,426,30,30],"spawn":"entrance","target":"guild_hall"},{"interact":true,"label":"Enter Maren's house","rect":[401,554,30,30],"spawn":"entrance","target":"house_elder"},{"interact":true,"label":"Enter the inn","rect":[1393,554,30,30],"spawn":"entrance","target":"house_inn"},{"interact":true,"label":"Enter the forge","rect":[433,1034,30,30],"spawn":"entrance","target":"house_smith"},{"interact":true,"label":"Climb down the well","level":12,"rect":[776,794,48,30],"spawn":"entrance","target":"well_shallow"}],"solid":[],"spawns":{"default":[912,832],"from_field":[912,1272],"from_guild_hall":[912,470],"from_house_elder":[416,598],"from_house_inn":[1408,598],"from_house_smith":[448,1078],"from_well":[800,840],"from_westwold":[96,720],"respawn":[912,832],"waystone":[1010,682],"waystone_havenbrook":[1010,682]},"subtitle":"A market town on the southern road","tile_size":16,"version":1,"water":[]},"name":"Havenbrook","tiles":{"barrel":{"filepath":"assets/props/barrel.png","locations":[[1032,840,40,40],[1388,238,40,40]]},"building_guild":{"filepath":"assets/objects/building_guild.png","locations":[[912,368,160,160]]},"building_house_a":{"filepath":"assets/objects/building_house_a.png","locations":[[416,504,144,144],[1984,373,136,149]]},"building_shop":{"filepath":"assets/objects/building_shop.png","locations":[[448,992,128,128]]},"bushsmall_00":{"filepath":"assets/objects/bushsmall_00.png","locations":[[116,786,32,32],[448,1244,32,32],[1560,893,32,32]]},"bushsmall_02":{"filepath":"assets/objects/bushsmall_02.png","locations":[[539,203,32,32],[468,1282,32,32]]},"bushsmall_04":{"filepath":"assets/objects/bushsmall_04.png","locations":[[1664,832,32,32],[617,217,32,32]]},"bushsmall_06":{"filepath":"assets/objects/bushsmall_06.png","locations":[[262,1183,32,32],[339,989,32,32]]},"crates_sacks":{"filepath":"as