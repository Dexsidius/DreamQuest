0,"cypress_litter_1":0,"cypress_litter_2":0,"cypress_tree":1,"drowned_loam":0,"drowned_loam_1":0,"drowned_loam_2":0,"hex_road":0,"hex_road_1":0,"reeds":1,"rocksmall_00":1,"rocksmall_02":1,"rocksmall_04":1,"rocksmall_06":1,"swamp_tree":1},"npcs":[],"objects":[{"id":"hex_drowns_lantern_0","sprite":"assets/props/hex_lantern.png","type":"lamp","x":1104,"y":1264},{"id":"hex_drowns_lantern_1","sprite":"assets/props/hex_lantern.png","type":"lamp","x":1136,"y":464},{"id":"hex_drowns_lantern_2","sprite":"assets/props/hex_lantern.png","type":"lamp","x":1680,"y":816},{"id":"sign_hex_drowns","sprite":"assets/props/signpost.png","text":"THE HEXMIRE\n\nPast here the cult keeps the swamp: the drums at night are theirs, and the lights in the jars. North, their fens, and their temple beyond. East, the Shellbacks' strand -- turtle-folk, as tall as a man, with claws like billhooks. They are at war with the cult, and will not stop to ask whose side you are on.\n\nScratched under it: FIFTY-FIVE. AND IT GETS WORSE.","title":"A post hung with a jar","type":"sign","x":1248,"y":1632}],"portals":[{"interact":false,"label":"Back to the Bayou","rect":[1088,1768,160,24],"spawn":"from_hexmire","target":"bayou"},{"interact":false,"label":"To the Candle Fens","rect":[1088,0,160,24],"spawn":"from_drowns","target":"hex_fens"},{"interact":false,"label":"To Shellback Strand","rect":[2280,832,24,160],"spawn":"from_drowns","target":"hex_strand"}],"solid":[],"spawns":{"default":[1168,1680],"from_bayou":[1168,1680],"from_fens":[1168,112],"from_strand":[2192,912]},"subtitle":"The Hexmire: black water under the cypress","tile_size":16,"version":1,"water":[]},"name":"The Cypress Drowns","tiles":{"blackwater":{"filepath":"assets/tiles/blackwater.png","locations":[[176,112,32,32],[2096,112,32,32],[1872,144,32,32],[2000,144,32,32],[1904,176,32,32],[2032,176,32,32],[2064,176,32,32],[2160,240,32,32],[624,272,32,32],[1776,272,32,32],[2128,272,32,32],[2096,304,32,32],[2160,304,32,32],[1712,336,32,32],[1744,336,32,3