eam","type":"sign","x":1232,"y":872},{"id":"board_reverie","quests":[],"sprite":"assets/objects/guild_noticeboard.png","title":"The Dreamer's Slate","type":"board","x":1298,"y":828},{"gather_time":3.0,"id":"dream_crystal_0","skill":"Mining","skill_level":1,"sprite":"assets/objects/rock_01.png","title":"dream crystal","type":"rock","x":1792,"y":800,"yield":"dream_shard","yield_xp":40},{"gather_time":3.0,"id":"dream_crystal_1","skill":"Mining","skill_level":1,"sprite":"assets/objects/rock_06.png","title":"dream crystal","type":"rock","x":2016,"y":768,"yield":"dream_shard","yield_xp":40},{"gather_time":3.0,"id":"dream_crystal_2","skill":"Mining","skill_level":1,"sprite":"assets/objects/rock_07.png","title":"dream crystal","type":"rock","x":2080,"y":928,"yield":"dream_shard","yield_xp":40},{"gather_time":3.0,"id":"dream_crystal_3","skill":"Mining","skill_level":1,"sprite":"assets/objects/rock_06.png","title":"dream crystal","type":"rock","x":1856,"y":992,"yield":"dream_shard","yield_xp":40},{"gather_time":3.0,"id":"dream_crystal_4","skill":"Mining","skill_level":1,"sprite":"assets/objects/rock_01.png","title":"dream crystal","type":"rock","x":1984,"y":1024,"yield":"dream_shard","yield_xp":40},{"gather_time":3.0,"id":"dream_crystal_5","skill":"Mining","skill_level":1,"sprite":"assets/objects/rock_03.png","title":"dream crystal","type":"rock","x":1760,"y":928,"yield":"dream_shard","yield_xp":40},{"id":"chest_dream","loot":"chest_dream","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":1184,"y":1632},{"gather_time":4.599999904632568,"id":"rock_950","skill":"Mining","skill_level":70,"sprite":"assets/objects/rock_05.png","title":"demonrite seam","type":"rock","x":1024,"y":1600,"yield":"demonrite_ore","yield_xp":410},{"gather_time":4.599999904632568,"id":"rock_951","skill":"Mining","skill_level":70,"sprite":"assets/objects/rock_04.png","title":"demonrite seam","type":"rock","x":1312,"y":1600,"yield":"demonrite_ore","yield_xp"