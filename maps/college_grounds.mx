ure Room","type":"sign","x":1760,"y":744},{"id":"sign_college_founders","sprite":"assets/props/signpost.png","text":"THE COLLEGE AT FERNHOLLOW\n\nThe hall, north. The practice hall, west. The lecture room, east.\n\nTHE FOUR FOUNDERS STAND ON THE LAWNS. THEY ARE OLDER THAN THE HAMLET AND THEY WILL OUTLAST IT.","title":"Cut into the gatepost","type":"sign","x":1056,"y":1368}],"portals":[{"interact":true,"label":"Enter the great hall","rect":[945,286,30,30],"spawn":"entrance","target":"fernhollow_college"},{"interact":false,"label":"To Fernhollow","rect":[896,1448,128,24],"spawn":"from_college_grounds","target":"fernhollow"},{"interact":false,"label":"The practice hall","rect":[0,768,24,64],"spawn":"entrance","target":"college_training"},{"interact":false,"label":"The lecture room","rect":[1896,768,24,64],"spawn":"entrance","target":"college_classroom"}],"solid":[],"spawns":{"default":[944,1344],"entrance":[944,1344],"from_college_classroom":[1792,800],"from_college_training":[128,800],"from_fernhollow_college":[960,330]},"subtitle":"Older than the hamlet, and not of it","tile_size":16,"version":1,"water":[]},"name":"The College at Fernhollow","tiles":{"college_banner":{"filepath":"assets/props/college_banner.png","locations":[[872,348,72,72],[1048,348,72,72],[872,668,72,72],[1048,668,72,72],[872,860,72,72],[1048,860,72,72],[872,1020,72,72],[1048,1020,72,72],[872,1148,72,72],[1048,1148,72,72],[872,1308,72,72],[1048,1308,72,72]]},"college_carpet":{"filepath":"assets/tiles/college_carpet.png","locations":[[16,784,32,32],[48,784,32,32],[80,784,32,32],[112,784,32,32],[144,784,32,32],[1776,784,32,32],[1808,784,32,32],[1840,784,32,32],[1872,784,32,32],[1904,784,32,32],[16,816,32,32],[48,816,32,32],[80,816,32,32],[112,816,32,32],[144,816,32,32],[1776,816,32,32],[1808,816,32,32],[1840,816,32,32],[1872,816,32,32],[1904,816,32,32]]},"college_column":{"filepath":"assets/props/college_column.png","locations":[[104,160,64,64],[1816,160,64,64],[104,256,64,64],[1816,256,64,64],[104,3