s/signpost.png","text":"THE GLASS MERE\n\nThe ice bears a walker. It does not bear a runner: run on it and it cracks behind you, and if you keep running it lets you in. The dark patches are worse; mind them walking too.\n\nThe house in the middle was Old Harl's. He walked out to it every winter for forty years. Walk.","title":"A board nailed to a stake at the water's edge","type":"sign","x":1728,"y":544}],"portals":[{"interact":false,"label":"To the Draugr Barrows","rect":[2280,832,24,160],"spawn":"from_mere","target":"frost_barrows"},{"interact":false,"label":"To the Warlord's Howe","rect":[1088,0,160,24],"spawn":"from_mere","target":"frost_howe"},{"interact":true,"label":"Go into the cabin","rect":[942,1031,36,18],"spawn":"entrance","target":"frost_cabin"}],"solid":[],"spawns":{"default":[2160,912],"from_barrows":[2192,912],"from_cabin":[960,1097],"from_howe":[1168,112]},"subtitle":"The Frostreach: the ice bears a walker","thin_ice":[{"rect":[736,512,256,32]},{"rect":[1056,512,64,32]},{"rect":[864,512,96,32],"weak":0.18000000715255737},{"rect":[1088,512,32,32],"weak":0.18000000715255737},{"rect":[672,544,576,32]},{"rect":[768,544,32,32],"weak":0.18000000715255737},{"rect":[896,544,32,32],"weak":0.18000000715255737},{"rect":[1088,544,64,32],"weak":0.18000000715255737},{"rect":[1184,544,64,32],"weak":0.18000000715255737},{"rect":[608,576,704,32]},{"rect":[768,576,96,32],"weak":0.18000000715255737},{"rect":[1056,576,192,32],"weak":0.18000000715255737},{"rect":[544,608,832,32]},{"rect":[768,608,96,32],"weak":0.18000000715255737},{"rect":[1056,608,192,32],"weak":0.18000000715255737},{"rect":[1344,608,32,32],"weak":0.18000000715255737},{"rect":[480,640,928,32]},{"rect":[768,640,96,32],"weak":0.18000000715255737},{"rect":[1088,640,160,32],"weak":0.18000000715255737},{"rect":[1344,640,64,32],"weak":0.18000000715255737},{"rect":[448,672,992,32]},{"rect":[832,672,96,32],"weak":0.18000000715255737},{"rect":[1056,672,192,32],"weak":0.18000000715255737},{"rect":[1376,672,64,32