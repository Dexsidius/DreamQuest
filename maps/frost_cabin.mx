ill not need it where I am going.","title":"Harl's journal","type":"sign","x":112,"y":256}],"portals":[{"interact":false,"label":"Back out onto the ice","rect":[192,320,64,32],"spawn":"from_cabin","target":"frost_mere"}],"solid":[],"spawns":{"default":[224,288],"entrance":[224,288]},"subtitle":"Out on the ice, and warm","tile_size":16,"version":1,"water":[]},"name":"Old Harl's Cabin","tiles":{"log_wall":{"filepath":"assets/tiles/log_wall.png","locations":[[16,16,32,32],[48,16,32,32],[80,16,32,32],[112,16,32,32],[144,16,32,32],[176,16,32,32],[208,16,32,32],[240,16,32,32],[272,16,32,32],[304,16,32,32],[336,16,32,32],[368,16,32,32],[400,16,32,32],[432,16,32,32],[16,48,32,32],[48,48,32,32],[80,48,32,32],[112,48,32,32],[144,48,32,32],[176,48,32,32],[208,48,32,32],[240,48,32,32],[272,48,32,32],[304,48,32,32],[336,48,32,32],[368,48,32,32],[400,48,32,32],[432,48,32,32],[16,80,32,32],[432,80,32,32],[16,112,32,32],[432,112,32,32],[16,144,32,32],[432,144,32,32],[16,176,32,32],[432,176,32,32],[16,208,32,32],[432,208,32,32],[16,240,32,32],[432,240,32,32],[16,272,32,32],[432,272,32,32],[16,304,32,32],[432,304,32,32],[16,336,32,32],[48,336,32,32],[80,336,32,32],[112,336,32,32],[144,336,32,32],[176,336,32,32],[272,336,32,32],[304,336,32,32],[336,336,32,32],[368,336,32,32],[400,336,32,32],[432,336,32,32]]},"pelt_rack":{"filepath":"assets/props/pelt_rack.png","locations":[[256,70,72,72]]},"plank_floor":{"filepath":"assets/tiles/plank_floor.png","locations":[[208,80,32,32],[80,112,32,32],[176,112,32,32],[272,112,32,32],[336,112,32,32],[208,144,32,32],[48,176,32,32],[80,176,32,32],[176,176,32,32],[304,176,32,32],[400,176,32,32],[80,208,32,32],[112,208,32,32],[144,208,32,32],[304,208,32,32],[336,208,32,32],[80,240,32,32],[144,240,32,32],[336,240,32,32],[112,272,32,32],[208,272,32,32],[304,272,32,32],[368,272,32,32],[208,304,32,32],[272,304,32,32],[336,304,32,32],[208,336,32,32],[240,336,32,32]]},"plank_floor_1":{"filepath":"assets/tiles/plank_floor_1.png","locations":[[80,80,32,32],[112