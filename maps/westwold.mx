ps/herb_marigold.png","sprite_open":"assets/props/herb_marigold_picked.png","title":"marigold","type":"herb","x":4400,"y":3248,"yield":"marigold","yield_xp":10},{"gather_time":1.472000002861023,"id":"herb_505","regrow":3.5,"skill":"Foraging","skill_level":6,"sprite":"assets/props/herb_brookmint.png","sprite_open":"assets/props/herb_brookmint_picked.png","title":"brookmint","type":"herb","x":2224,"y":3284,"yield":"brookmint","yield_xp":18},{"gather_time":1.4119999408721924,"id":"herb_506","regrow":3.0833332538604736,"skill":"Foraging","skill_level":1,"sprite":"assets/props/herb_marigold.png","sprite_open":"assets/props/herb_marigold_picked.png","title":"marigold","type":"herb","x":3472,"y":3280,"yield":"marigold","yield_xp":10},{"id":"campsite_hidewater","sprite":"assets/props/tent.png","title":"Campsite","type":"campsite","x":4296,"y":1320},{"id":"bench_hidewater","sprite":"assets/props/workbench.png","station":"workbench","title":"Tanner's bench","type":"workbench","x":4036,"y":1286},{"id":"cauldron_hidewater","sprite":"assets/props/cauldron.png","station":"cauldron","title":"Cauldron","type":"workbench","x":4136,"y":1290},{"id":"range_hidewater","sprite":"assets/props/campfire_ring.png","title":"Cooking fire","type":"range","x":4206,"y":1340},{"id":"sign_hidewater","sprite":"assets/props/signpost.png","text":"HIDEWATER STEADING\n\nHides bought, any beast, any size. Leathers cut to order.\n\nBelow, in a neater hand: cloth woven and dyed. Bring flax, or buy it.","title":"Hidewater","type":"sign","x":4136,"y":1504},{"id":"waystone_shepherds","sprite":"assets/objects/rock_05.png","text":"Seven stones, and older than the road.\n\nCut into the tallest, the marks of a tally nobody keeps any more: sheep out, sheep back. The second column stops short.","title":"The Shepherds' Ring","type":"sign","x":1744,"y":2328},{"id":"chest_shepherds_ring","loot":"chest_common","sprite":"assets/objects/chest.png","sprite_open":"assets/objects/chest_open.png","type":"chest","x":1784,"y":2350},{"id":"sign_westwold_fork","sprite":"assets/props/signpost.png","text":"THE BRACKENWOOD, north. Bears. Do not leave food by the path.\nTHE HOWLING FELLS, west. Do not.\nHAVENBROOK, east, and supper.","title":"The fork","type":"sign","x":1472,"y":1504},{"id":"sign_fells","sprite":"assets/props/signpost.png","text":"THE HOWLING FELLS\n\nGreatwolves hunt the high ground. They are the size of a pony and they are not afraid of you.\n\nCombat 55, and company, or turn round.","title":"A warning, nailed to a post","type":"sign","x":928,"y":1376},{"fish":["raw_minnow","raw_trout","raw_pike"],"gather_time":3.5999999046325684,"id":"fish_wend_0","skill":"Fishing","skill_level":1,"title":"stream","type":"fishing_spot","x":2488,"y":464},{"fish":["raw_minnow","raw_trout","raw_pike"],"gather_time":3.5999999046325684,"id":"fish_wend_1","skill":"Fishing","skill_level":1,"title":"stream","type":"fishing_spot","x":2360,"y":976},{"fish":["raw_minnow","raw_trout","raw_pike"],"gather_time":3.5999999046325684,"id":"fish_wend_2","skill":"Fishing","skill_level":1,"title":"stream","type":"fishing_spot","x":2392,"y":2256},{"fish":["raw_minnow","raw_trout","raw_pike"],"gather_time":3.5999999046325684,"id":"fish_wend_3","skill":"Fishing","skill_level":1,"title":"stream","type":"fishing_spot","x":2232,"y":2832}],"portals":[{"interact":false,"label":"To Havenbrook","rect":[4776,1592,24,144],"spawn":"from_westwold","target":"town_havenbrook"},{"interact":false,"label":"To the Brackenwood","level":20,"rect":[1208,0,144,24],"spawn":"from_westwold","target":"brackenwood"}],"solid":[],"spawns":{"default":[4704,1680],"from_brackenwood":[1296,96],"from_havenbrook":[4704,1680]},"subtitle":"Open downs west of Havenbrook, and the road across them","tile_size":16,"version":1},"name":"The Westwold","tiles":{"barrel":{"filepath":"assets/props/barrel.png","locations":[[4100,1200,40,40]]},"bush_00":{"filepath":"assets/objects/bush_00.png","locations":[[4336,272,64,64],[3952,368,64,64],[1616,1552,64,64],[20